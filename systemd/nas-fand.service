[Unit]
Description=Temperature-driven fan control for ASUSTOR NAS hardware
Documentation=file:///usr/local/share/doc/asustor-nas-control/thermal-and-lcd.md
After=multi-user.target
# No IT87 fan controller, no reason to run.
ConditionPathExistsGlob=/sys/devices/platform/asustor_it87.*

# Give up after five failures in five minutes rather than restarting forever.
# Stopping is safe here precisely because ExecStopPost has already driven the
# fan to full: a permanently failed unit leaves the box loud and obvious, and
# nas-status reports it, which beats a five-second restart loop nobody reads.
# These are [Unit] keys; in [Service] systemd ignores them and there is no limit.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Refuse to start on a configuration that would misdrive a fan, rather than
# starting and finding out at 85 C.
ExecStartPre=/usr/local/bin/nas-fand --check
ExecStart=/usr/local/bin/nas-fand

# The daemon traps its own exit and drives the fan to full. A SIGKILL never
# reaches that trap, so systemd repeats it from the outside. Both paths are
# deliberate: a fan daemon that is not running must leave a NAS loud, because
# silence is the failure you discover when a disk has already died.
ExecStopPost=/usr/local/bin/nas-fand --failsafe

Restart=always
RestartSec=5

# Writes to /sys, so ProtectKernelTunables and ProtectSystem=strict are both
# out -- they would make the one file this daemon exists to write read-only.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
Nice=-5

[Install]
WantedBy=multi-user.target
