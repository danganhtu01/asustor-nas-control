note "state file:  $NCT_CONF (nextcloud-uninstall reads only this)"
note "  DOCKER_ENABLED_BY_US=$DOCKER_ENABLED_BY_US TS_SERVE_SET_BY_US=$TS_SERVE_SET_BY_US ZRAM_BY_US=$ZRAM_BY_US SYSCTL_BY_US=$SYSCTL_BY_US OOMADJ_BY_US=$OOMADJ_BY_US"
if (( OOMADJ_BY_US )); then
  note 'tailscaled OOMScoreAdjust=-900 is written but takes effect at the NEXT BOOT.'
  note 'tailscaled was deliberately not restarted: that drops the SSH session you are on.'
fi
if (( SYSCTL_BY_US )); then
  note 'IP forwarding was enabled before Docker started; removing the sysctl file later'
  note 'does not reset it at runtime - that needs a reboot or an explicit sysctl -w.'
fi
note ''
note 'Next commands:'
note '  nextcloud-status      health, certificate expiry, free space, the login/v2 probe'
note '  nextcloud-postflight  assert that nothing on this box was disturbed'
note '  nextcloud-occ status  run occ inside the app container'
note '  nextcloud-uninstall --help'
note ''
note 'Deliberately NOT installed: notify_push, previewgenerator, Collabora,'
note 'OnlyOffice, Talk HPB and Imaginary. Desktop clients poll every 30 seconds,'
note 'which is the real vanilla behaviour. nextcloud-push-enable is the documented'
note 'follow-up and refuses under 6 GiB of RAM.'
note ''
note 'Before you reboot to prove the stack comes back, check all three:'
note '  systemctl is-enabled tailscaled'
note '  the tailnet node key is not expired'
note '  the bootloader still has a previous-kernel entry'
