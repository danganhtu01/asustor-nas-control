# /etc/m365-backup/m365-backup.conf
# Sourced by m365-backup-lib. Shell syntax. Mode 0600.
# Contains no secret itself -- only the path to one.

# --- identity (required) ------------------------------------------------------

# Entra tenant ID (Directory ID), not the domain name.
M365_TENANT=''

# Application (client) ID of the single backup app registration.
# One registration, tenant-wide. Do not create one app per department: SharePoint
# meters resource units per tenant, so extra AppIDs drain the same bucket faster,
# and Microsoft documents this exact pattern as a reason applications get blocked.
M365_CLIENT_ID=''

# File holding the client secret and nothing else -- no trailing newline.
#   install -d -m 0700 /etc/m365-backup
#   printf %s 'THE-SECRET-VALUE' > /etc/m365-backup/client_secret
#   chmod 400 /etc/m365-backup/client_secret
M365_SECRET_FILE='/etc/m365-backup/client_secret'

# --- where it lands -----------------------------------------------------------
#
# Composed, never written out literally:
#
#     M365_DEST_ROOT = NAS_MOUNT_BASE / NAS_M365_VOLUME / M365_SUBDIR
#
# Override any single layer here, or export it for a one-off run. Relocating a
# volume is then a variable change rather than a hunt through scripts.
#
# The default targets NAS_03 on purpose: that volume is where the existing cloud
# mirror sweep writes, so anything placed there is carried into the nightly
# NAS_03 -> NAS_02 snapshot with no extra wiring.

#NAS_MOUNT_BASE='/srv'
#NAS_M365_VOLUME='NAS_03'
#M365_SUBDIR='m365'

# Setting this explicitly overrides all three layers above.
#M365_DEST_ROOT=''

# The volume that must genuinely be mounted. Defaults to
# $NAS_MOUNT_BASE/$NAS_M365_VOLUME. The sync refuses to start unless this is a
# real mountpoint -- an unmounted volume is just a directory, and a tenant mirror
# written into one fills whatever filesystem is actually underneath.
#M365_VOLUME_ROOT=''

# Resulting layout:
#   $M365_DEST_ROOT/current/onedrive/<upn>/...
#   $M365_DEST_ROOT/current/sharepoint/<site>/<library>/...
#   $M365_DEST_ROOT/archive/<run-stamp>/...    replaced + deleted files
#   $M365_DEST_ROOT/_logs/<run-stamp>/         one log per drive

# --- tuning (optional) --------------------------------------------------------

# Refuse to start below this many GiB free.
#M365_MIN_FREE_GIB=50

# Requests per second, tenant-wide. 8 is ~77% of the documented ceiling for a
# tenant under 1,000 licences, leaving headroom for other apps on the same bucket.
#M365_TPSLIMIT=8
#M365_TRANSFERS=4
#M365_CHECKERS=8

# Cap bandwidth so a nightly run does not saturate the office uplink.
# rclone syntax, e.g. '20M' or '08:00,1M 22:00,off'
#M365_BWLIMIT=''

#M365_STATE='/var/lib/m365-backup'
#M365_LOG_DIR=''

# Traffic decoration. NONISV is correct for an organisation's own internal tool;
# ISV is for vendors shipping a product. Undecorated traffic is de-prioritised.
#M365_USER_AGENT='NONISV|DangAssociates|NasBackup/1.0'

# Set to 1 only if the volume is deliberately not a mountpoint.
#M365_ALLOW_NON_MOUNTPOINT=0
